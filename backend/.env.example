OPERAI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/operai
OPERAI_JWT_SECRET=change-this-secret-with-at-least-32-characters
OPERAI_ACCESS_TOKEN_MINUTES=30
OPERAI_REFRESH_TOKEN_DAYS=30
OPERAI_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OPERAI_ASAAS_API_KEY=
OPERAI_ASAAS_API_URL=https://sandbox.asaas.com/api/v3
OPERAI_ASAAS_WEBHOOK_TOKEN=dev-asaas-webhook
OPERAI_TRIAL_DAYS=14
OPERAI_ENCRYPTION_KEY=
OPERAI_EVOLUTION_API_URL=
OPERAI_EVOLUTION_API_KEY=
OPERAI_PUBLIC_API_URL=http://127.0.0.1:8001
OPERAI_FRONTEND_URL=http://localhost:3000

# Produção (Neon): cole a connection string; postgres:// ou postgresql:// são convertidos para +asyncpg automaticamente.
